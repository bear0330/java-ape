+// Java APE Host Services is a deliberately narrow, value-oriented escape
+// hatch. It is enabled only when both environment variables are present.
+// The per-method native wrapper supplies the Method and an already marshalled
+// jvalue array, so these fixed C signatures never depend on a JNI method ABI.
+static bool java_ape_host_enabled() {
+#ifdef __COSMOPOLITAN__
+  const char* host = ::getenv("JAVA_APE_HOST");
+  const char* token = ::getenv("JAVA_APE_HOST_TOKEN");
+  return host != nullptr && *host != '\0' && token != nullptr && *token != '\0';
+#else
+  return false;
+#endif
+}
+
+static jobject java_ape_host_box(JNIEnv* env, BasicType type, jvalue value) {
+  if (is_reference_type(type)) return value.l;
+  const char* klass = nullptr;
+  const char* signature = nullptr;
+  switch (type) {
+    case T_BOOLEAN: klass = "java/lang/Boolean";   signature = "(Z)Ljava/lang/Boolean;"; break;
+    case T_BYTE:    klass = "java/lang/Byte";      signature = "(B)Ljava/lang/Byte;"; break;
+    case T_CHAR:    klass = "java/lang/Character"; signature = "(C)Ljava/lang/Character;"; break;
+    case T_SHORT:   klass = "java/lang/Short";     signature = "(S)Ljava/lang/Short;"; break;
+    case T_INT:     klass = "java/lang/Integer";   signature = "(I)Ljava/lang/Integer;"; break;
+    case T_LONG:    klass = "java/lang/Long";      signature = "(J)Ljava/lang/Long;"; break;
+    case T_FLOAT:   klass = "java/lang/Float";     signature = "(F)Ljava/lang/Float;"; break;
+    case T_DOUBLE:  klass = "java/lang/Double";    signature = "(D)Ljava/lang/Double;"; break;
+    default: return nullptr;
+  }
+  jclass c = env->FindClass(klass);
+  if (c == nullptr) return nullptr;
+  jmethodID value_of = env->GetStaticMethodID(c, "valueOf", signature);
+  if (value_of == nullptr) return nullptr;
+  switch (type) {
+    case T_BOOLEAN: return env->CallStaticObjectMethod(c, value_of, value.z);
+    case T_BYTE:    return env->CallStaticObjectMethod(c, value_of, value.b);
+    case T_CHAR:    return env->CallStaticObjectMethod(c, value_of, value.c);
+    case T_SHORT:   return env->CallStaticObjectMethod(c, value_of, value.s);
+    case T_INT:     return env->CallStaticObjectMethod(c, value_of, value.i);
+    case T_LONG:    return env->CallStaticObjectMethod(c, value_of, value.j);
+    case T_FLOAT:   return env->CallStaticObjectMethod(c, value_of, value.f);
+    case T_DOUBLE:  return env->CallStaticObjectMethod(c, value_of, value.d);
+    default: ShouldNotReachHere(); return nullptr;
+  }
+}
+
+static Method* java_ape_host_current_method(bool* interpreted) {
+  JavaThread* thread = JavaThread::current();
+  if (!thread->has_last_Java_frame()) return nullptr;
+  frame caller = thread->last_frame();
+  if (caller.is_interpreted_frame()) {
+    *interpreted = true;
+    return caller.interpreter_frame_method();
+  }
+  nmethod* wrapper = CodeCache::find_nmethod(thread->last_Java_pc());
+  return wrapper == nullptr ? nullptr : wrapper->method();
+}
+
+static jvalue* java_ape_host_interpreter_values(Method* method) {
+  JavaThread* thread = JavaThread::current();
+  frame caller = thread->last_frame();
+  jvalue* values = NEW_RESOURCE_ARRAY(jvalue, method->size_of_parameters());
+  int index = method->is_static() ? 0 : 1;
+  for (SignatureStream ss(method->signature()); !ss.at_return_type(); ss.next(), ++index) {
+    intptr_t* slot = caller.interpreter_frame_local_at(
+        index + ((ss.type() == T_LONG || ss.type() == T_DOUBLE) ? 1 : 0));
+    switch (ss.type()) {
+      case T_BOOLEAN: values[index].z = *(jboolean*)slot; break;
+      case T_BYTE:    values[index].b = *(jbyte*)slot; break;
+      case T_CHAR:    values[index].c = *(jchar*)slot; break;
+      case T_SHORT:   values[index].s = *(jshort*)slot; break;
+      case T_INT:     values[index].i = *(jint*)slot; break;
+      case T_LONG:    values[index].j = *(jlong*)slot; ++index; break;
+      case T_FLOAT:   values[index].f = *(jfloat*)slot; break;
+      case T_DOUBLE:  values[index].d = *(jdouble*)slot; ++index; break;
+      case T_ARRAY:
+      case T_OBJECT: {
+        oop value = *(oop*)slot;
+        values[index].l = value == nullptr ? nullptr : JNIHandles::make_local(value);
+        break;
+      }
+      default: ShouldNotReachHere();
+    }
+  }
+  return values;
+}
