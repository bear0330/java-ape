+static address java_ape_host_entry(BasicType type) {
+  switch (type) {
+    case T_BOOLEAN: return CAST_FROM_FN_PTR(address, java_ape_host_boolean);
+    case T_BYTE:    return CAST_FROM_FN_PTR(address, java_ape_host_byte);
+    case T_CHAR:    return CAST_FROM_FN_PTR(address, java_ape_host_char);
+    case T_SHORT:   return CAST_FROM_FN_PTR(address, java_ape_host_short);
+    case T_INT:     return CAST_FROM_FN_PTR(address, java_ape_host_int);
+    case T_LONG:    return CAST_FROM_FN_PTR(address, java_ape_host_long);
+    case T_FLOAT:   return CAST_FROM_FN_PTR(address, java_ape_host_float);
+    case T_DOUBLE:  return CAST_FROM_FN_PTR(address, java_ape_host_double);
+    case T_ARRAY:
+    case T_OBJECT:  return CAST_FROM_FN_PTR(address, java_ape_host_object);
+    case T_VOID:    return CAST_FROM_FN_PTR(address, java_ape_host_void);
+    default: ShouldNotReachHere(); return nullptr;
+  }
