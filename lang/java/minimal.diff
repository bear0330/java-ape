+static jobject java_ape_host_invoke(JNIEnv* env, jvalue* values) {
+  bool interpreted = false;
+  Method* method = java_ape_host_current_method(&interpreted);
+  if (method == nullptr) return nullptr;
+  if (interpreted) values = java_ape_host_interpreter_values(method);
+  jclass host = env->FindClass("com/nuwainfo/javaape/HostServices");
+  if (host == nullptr) return nullptr;
+  jmethodID call = env->GetStaticMethodID(host, "callNative",
+      "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/Object;");
+  if (call == nullptr) return nullptr;
+  jclass object = env->FindClass("java/lang/Object");
+  if (object == nullptr) return nullptr;
+  int count = 0;
+  for (SignatureStream ss(method->signature()); !ss.at_return_type(); ss.next()) ++count;
+  jobjectArray args = env->NewObjectArray(count, object, nullptr);
+  if (args == nullptr) return nullptr;
+  int index = method->is_static() ? 0 : 1;
+  int out = 0;
+  for (SignatureStream ss(method->signature()); !ss.at_return_type(); ss.next(), ++index, ++out) {
+    jobject boxed = java_ape_host_box(env, ss.type(), values[index]);
+    if (env->ExceptionCheck()) return nullptr;
+    env->SetObjectArrayElement(args, out, boxed);
+    if (env->ExceptionCheck()) return nullptr;
+    if (ss.type() == T_LONG || ss.type() == T_DOUBLE) ++index;
+  }
+  jstring owner = env->NewStringUTF(method->klass_name()->as_C_string());
+  jstring name = env->NewStringUTF(method->name()->as_C_string());
+  jstring descriptor = env->NewStringUTF(method->signature()->as_C_string());
+  if (owner == nullptr || name == nullptr || descriptor == nullptr) return nullptr;
+  return env->CallStaticObjectMethod(host, call, owner, name, descriptor, args);
+}
