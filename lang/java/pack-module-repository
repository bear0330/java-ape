#!/bin/sh
# Produce every Java module built from this exact OpenJDK tree. This is not
# embedded in java.com; downstream package builders can select module closures.
set -eu
SRC=${1:?OpenJDK source root required}
OUT=${2:?output ZIP required}
CONF=${CONF:-cosmo-release}
MB="$SRC/build/$CONF"
BASELOC=${BASELOC:?}
STAGE=$(mktemp -d "${TMPDIR:-/tmp}/openjdk-cosmo-modules.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT INT TERM
mkdir -p "$STAGE/modules" "$(dirname "$OUT")"

count=0
for module in "$MB"/jdk/modules/*; do
  test -d "$module" || continue
  cp -a "$module" "$STAGE/modules/"
  count=$((count + 1))
done
test "$count" -gt 0 || { echo 'no compiled Java modules found' >&2; exit 1; }
( cd "$STAGE" && zip -q -r "$OUT" modules )
printf 'Packed %s Java modules: %s\n' "$count" "$OUT"
