#!/bin/sh
set -eu
SRC=${1:?OpenJDK source root required}
OUTDIR=${2:?output directory required}
ARCH=${ARCH:-x86_64}
if [ "$ARCH" = aarch64 ]; then
  CONF=${CONF:-cosmo-release-aarch64}
  MODULES_CONF=${MODULES_CONF:-cosmo-release}
else
  CONF=${CONF:-cosmo-release}
  MODULES_CONF=$CONF
fi
B="$SRC/build/$CONF"
MB="$SRC/build/$MODULES_CONF"
LAUNCHER="$B/support/static-native/launcher/java"

MODULES='java.base java.compiler java.logging java.management java.naming java.net.http java.prefs java.rmi java.scripting java.security.sasl java.sql java.transaction.xa java.xml jdk.crypto.ec jdk.naming.dns jdk.naming.rmi jdk.unsupported jdk.zipfs'

test -x "$LAUNCHER" || { echo "missing static launcher: $LAUNCHER" >&2; exit 1; }

mkdir -p "$OUTDIR"
cp -f "$LAUNCHER" "$OUTDIR/java"
chmod +x "$OUTDIR/java"

# AArch64 reuses the x86_64 JRE module payload.  If this tree has no x86
# module output, take the already-packed zip from the x86_64 install or
# skip packing (fatten can unzip results/bin/java.com).
X86_PAYLOAD="${BASELOC:+$BASELOC/o/lang/java/install/x86_64/bin/jre-payload.zip}"
if [ "$ARCH" = aarch64 ] && [ ! -d "$MB/jdk/modules/java.base" ]; then
  if [ -n "$X86_PAYLOAD" ] && [ -f "$X86_PAYLOAD" ]; then
    cp -f "$X86_PAYLOAD" "$OUTDIR/jre-payload.zip"
  fi
  exit 0
fi

STAGE=$(mktemp -d "${TMPDIR:-/tmp}/openjdk-cosmo-jre.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT INT TERM
mkdir -p "$STAGE/modules" "$STAGE/conf" "$STAGE/lib/security"
HOST_SHIM="$BASELOC/o/lang/java/host-shim/java-ape-host.jar"
"$BASELOC/lang/java/build-host-shim" "$HOST_SHIM"
mkdir -p "$STAGE/lib/java-ape/classes"
unzip -q "$HOST_SHIM" -d "$STAGE/lib/java-ape/classes"
for m in $MODULES; do
  test -d "$MB/jdk/modules/$m" || { echo "missing module output: $m" >&2; exit 1; }
  cp -a "$MB/jdk/modules/$m" "$STAGE/modules/$m"
done

for m in java.base java.logging java.xml; do
  if test -d "$MB/support/modules_conf/$m"; then
    cp -a "$MB/support/modules_conf/$m/." "$STAGE/conf/"
  fi
done

cp "$MB/support/modules_libs/java.base/tzdb.dat" "$STAGE/lib/tzdb.dat"
cp "$MB/support/modules_libs/java.base/jvm.cfg" "$STAGE/lib/jvm.cfg"
cp "$MB/support/modules_libs/java.base/security/cacerts" "$STAGE/lib/security/cacerts"
cp "$MB/support/modules_libs/java.base/security/blocked.certs" "$STAGE/lib/security/blocked.certs"
cp "$MB/support/modules_libs/java.base/security/public_suffix_list.dat" "$STAGE/lib/security/public_suffix_list.dat"

PAYLOAD="$OUTDIR/jre-payload.zip"
rm -f "$PAYLOAD"
( cd "$STAGE" && zip -q -r "$PAYLOAD" . )
