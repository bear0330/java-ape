#!/bin/sh
# Compile HotSpot C sources without cosmocc's TLS assembly rewriter.
#
# tlscc changes GCC's Linux __thread base (%fs:0) into Cosmopolitan's TIB
# (%fs:0x30). HotSpot relies on the former for its compiler-thread state.
# Link invocations intentionally continue through the ordinary setup cosmocc
# driver, so this only affects generated object code.
set -eu
: "${BASELOC:?}"
for arg; do
  case "$arg" in
    -c|-S)
      exec "$BASELOC/cosmopolitan/cosmocc/bin/x86_64-unknown-cosmo-cc" \
        -moptlinux -mno-red-zone "$@"
      ;;
  esac
done
exec "$BASELOC/cosmopolitan/cosmocc/bin/x86_64-unknown-cosmo-cc" "$@"
