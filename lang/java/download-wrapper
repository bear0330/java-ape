#!/bin/sh
set -eu
src=${1:?OpenJDK source archive required}
url=${2:?OpenJDK source URL required}

if ! test -f "$src"; then
  mkdir -p "$(dirname "$src")"
  tmp="$src.tmp.$$"
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 -o "$tmp" "$url"
  else
    wget -O "$tmp" "$url"
  fi
  mv "$tmp" "$src"
  trap - EXIT HUP INT TERM
fi

# Superconfigure's default checker expects sources.tar.gz in the package
# build directory.  Keep the pinned filename in distfiles/ and copy it here.
cp -f "$src" sources.tar.gz
