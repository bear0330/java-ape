--- a/.github/scripts/cosmo
+++ b/.github/scripts/cosmo
@@ -6,6 +6,12 @@
 export COSMO="${COSMO:-$BASELOC/cosmopolitan}"
 export RESULTS="${RESULTS:-$BASELOC/results}"
 export HOSTARCH="${HOSTARCH:-$(uname -m)}"
+if command -v gmake >/dev/null 2>&1; then
+    MAKE_CMD=$(command -v gmake)
+else
+    MAKE_CMD=$(command -v make)
+fi
+
 
 # create the COSMOS and related folders
 cd "$BASELOC"
@@ -33,6 +39,23 @@
 echo "updating compiler binaries"
 # don't need to download gcc binaries because package.sh does it
 cd "$COSMO"
+if [ "$(uname -s)" = Darwin ]; then
+    # dedupe is an AArch64 Linux ELF, which macOS cannot execute.  It only
+    # reduces package size, so leave all package contents intact and skip it.
+    PACKAGE_SCRIPT=tool/cosmocc/package.sh
+    if ! grep -Fq 'Java APE overlay: skip ELF dedupe on Darwin' "$PACKAGE_SCRIPT"; then
+        sed -i '' '/^\$DEDUPE -s "\$OUTDIR\/"$/c\
+# Java APE overlay: skip ELF dedupe on Darwin\
+if [ "$(uname -s)" != Darwin ]; then\
+  $DEDUPE -s "$OUTDIR/"\
+fi' "$PACKAGE_SCRIPT"
+        grep -Fq 'Java APE overlay: skip ELF dedupe on Darwin' "$PACKAGE_SCRIPT" || {
+            echo "unable to patch $PACKAGE_SCRIPT for Darwin" >&2
+            exit 1
+        }
+    fi
+fi
+
 bash tool/cosmocc/package.sh cosmocc
 
 # package.sh builds a bunch of MODEs, we only need x86_64 and aarch64
@@ -41,15 +64,15 @@
     o/x86_64-tiny/ o/x86_64-dbg o/x86_64-optlinux/
 
 cd "$COSMO"
