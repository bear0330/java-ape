@@ -35 +41,18 @@
 cd "$COSMO"
+if [ "$(uname -s)" = Darwin ]; then
+    # dedupe is an AArch64 Linux ELF, which macOS cannot execute.  It only
+    # reduces package size, so leave all package contents intact and skip it.
+    PACKAGE_SCRIPT=tool/cosmocc/package.sh
+    if ! grep -Fq 'Java APE overlay: skip ELF dedupe on Darwin' "$PACKAGE_SCRIPT"; then
+        sed -i '' '/^\$DEDUPE -s "\$OUTDIR\/"$/c\
+# Java APE overlay: skip ELF dedupe on Darwin\
+if [ "$(uname -s)" != Darwin ]; then\
+  $DEDUPE -s "$OUTDIR/"\
+fi' "$PACKAGE_SCRIPT"
+        grep -Fq 'Java APE overlay: skip ELF dedupe on Darwin' "$PACKAGE_SCRIPT" || {
+            echo "unable to patch $PACKAGE_SCRIPT for Darwin" >&2
+            exit 1
+        }
+    fi
+fi
+
