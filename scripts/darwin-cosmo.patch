@@ -7,2 +7,8 @@ export COSMO="${COSMO:-$BASELOC/cosmopolitan}"
 export RESULTS="${RESULTS:-$BASELOC/results}"
 export HOSTARCH="${HOSTARCH:-$(uname -m)}"
+if command -v gmake >/dev/null 2>&1; then
